<?xml version="1.0" encoding="UTF-8"?>
<!--
  Production-shaped sample. Run ./scripts/setup-prod.sh (local) or
  ./scripts/setup-openshift-demo.sh (OpenShift public demo) first.

  The Lightwell token stays on Artifactory or Nexus. Do not put it in this file.
  lightwell-java searches predisclosure → remediated → validated (prod setup),
  or remediated → validated (public demo / OpenShift).

  Default URL is this kit's OpenShift Artifactory Route.
  Change lightwell.version to the .rhlw build you are adopting.
  Artifactory/Nexus login: -s samples/settings.xml (admin / Lightwell-demo1).

  OpenShift Artifactory (default below):
    mvn -f samples/prod/pom.xml -s samples/settings.xml dependency:resolve

  OpenShift Nexus:
    mvn -f samples/prod/pom.xml -s samples/settings.xml dependency:resolve \
      -Dlightwell.repo.url=https://nexus-lightwell-demo.apps.asaran.na-launch.com/repository/lightwell-java

  Local Podman Artifactory:
    mvn -f samples/prod/pom.xml -s samples/settings.xml dependency:resolve \
      -Dlightwell.repo.url=http://127.0.0.1:8082/artifactory/lightwell-java

  Local Podman Nexus:
    mvn -f samples/prod/pom.xml -s samples/settings.xml dependency:resolve \
      -Dlightwell.repo.url=http://127.0.0.1:8083/repository/lightwell-java
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>lightwell-prod</artifactId>
  <version>1.0.0</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <lightwell.repo.url>https://artifactory-lightwell-demo.apps.asaran.na-launch.com/artifactory/lightwell-java</lightwell.repo.url>
    <lightwell.version>1.33.0.rhlw-00001</lightwell.version>
  </properties>

  <repositories>
    <repository>
      <id>lightwell-java</id>
      <name>Lightwell Java</name>
      <url>${lightwell.repo.url}</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>${lightwell.version}</version>
    </dependency>
  </dependencies>
</project>
