<?xml version="1.0" encoding="UTF-8"?>
<!--
  Production-shaped sample. Run ./scripts/setup-prod.sh (local) or
  ./scripts/setup-openshift-demo.sh (OpenShift public demo) first.

  Same story as samples/demo/pom.xml: Maven stays on acmebank_java_repo.
  Server resolve order: remediated → validated → maven-central (lowest).
  Change lightwell.version to the .rhlw build you are adopting.
  Nexus login: -s samples/settings.xml.

  OpenShift Nexus (default below):
    mvn -f samples/prod/pom.xml -s samples/settings.xml dependency:resolve

  OpenShift Artifactory:
    mvn -f samples/prod/pom.xml -s samples/settings.xml dependency:resolve \
      -Dacmebank.repo.url=https://artifactory-lightwell-demo.apps.asaran.na-launch.com/artifactory/acmebank_java_repo

  JFrog trial:
    mvn -f samples/prod/pom.xml -s samples/settings.xml dependency:resolve \
      -Dacmebank.repo.url=https://trial72lbp4.jfrog.io/artifactory/acmebank_java_repo

  Local Podman Artifactory:
    mvn -f samples/prod/pom.xml -s samples/settings.xml dependency:resolve \
      -Dacmebank.repo.url=http://127.0.0.1:8082/artifactory/acmebank_java_repo

  Local Podman Nexus:
    mvn -f samples/prod/pom.xml -s samples/settings.xml dependency:resolve \
      -Dacmebank.repo.url=http://127.0.0.1:8083/repository/acmebank_java_repo
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>lightwell-prod</artifactId>
  <version>1.0.0</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <acmebank.repo.url>https://nexus-lightwell-demo.apps.asaran.na-launch.com/repository/acmebank_java_repo</acmebank.repo.url>
    <lightwell.version>1.33.0.rhlw-00001</lightwell.version>
  </properties>

  <repositories>
    <repository>
      <id>acmebank_java_repo</id>
      <name>Acme Bank Java (existing org virtual)</name>
      <url>${acmebank.repo.url}</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>acmebank_java_repo</id>
      <name>Acme Bank Java (existing org virtual)</name>
      <url>${acmebank.repo.url}</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>

  <dependencies>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>${lightwell.version}</version>
    </dependency>
  </dependencies>
</project>
