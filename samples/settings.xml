<?xml version="1.0" encoding="UTF-8"?>
<!--
  Demo login for Artifactory and Nexus (local Podman or OpenShift Routes).
  This is the repository server login, not the Lightwell token.
  Password is demo-only. Do not reuse it on a shared server.

  The <server><id> must match the <repository><id> in the pom (lightwell-java).
  Copy this <servers> block into ~/.m2/settings.xml for day-to-day use, or pass -s.

  Local:
    mvn -f samples/demo/pom.xml -s samples/settings.xml dependency:resolve

  OpenShift Artifactory:
    mvn -f samples/demo/pom.xml -s samples/settings.xml dependency:resolve \
      -Dlightwell.repo.url=https://artifactory-lightwell-demo.apps.asaran.na-launch.com/artifactory/lightwell-java
-->
<settings>
  <servers>
    <server>
      <id>lightwell-java</id>
      <username>admin</username>
      <password>Lightwell-demo1</password>
    </server>
  </servers>
</settings>
