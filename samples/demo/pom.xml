<?xml version="1.0" encoding="UTF-8"?>
<!--
  Public demo. Run ./scripts/setup-demo.sh (local) or
  ./scripts/setup-openshift-demo.sh (OpenShift) first.

  Story: acmebank_java_repo is the virtual/group every team already uses.
  Server resolve order (first match wins):
    1. lightwell-java-remediated
    2. lightwell-java-validated
    3. maven-central          ← lowest; non-.rhlw deps still succeed

  lightwell-java is the dedicated Lightwell virtual (members 1–2) that admins
  add to acmebank_java_repo ahead of maven-central. Developers keep the same
  repository id/URL and only change a dependency version to a .rhlw build.

  Credentials: samples/settings.xml (id acmebank_java_repo). Not a Lightwell token.

  Local Artifactory (default URL below):
    mvn -f samples/demo/pom.xml -s samples/settings.xml dependency:resolve

  Local Nexus:
    mvn -f samples/demo/pom.xml -s samples/settings.xml dependency:resolve \
      -Dacmebank.repo.url=http://127.0.0.1:8083/repository/acmebank_java_repo

  OpenShift Artifactory:
    mvn -f samples/demo/pom.xml -s samples/settings.xml dependency:resolve \
      -Dacmebank.repo.url=https://artifactory-lightwell-demo.apps.asaran.na-launch.com/artifactory/acmebank_java_repo

  OpenShift Nexus:
    mvn -f samples/demo/pom.xml -s samples/settings.xml dependency:resolve \
      -Dacmebank.repo.url=https://nexus-lightwell-demo.apps.asaran.na-launch.com/repository/acmebank_java_repo
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>lightwell-demo</artifactId>
  <version>1.0.0</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <acmebank.repo.url>http://127.0.0.1:8082/artifactory/acmebank_java_repo</acmebank.repo.url>
  </properties>

  <!-- Same id/URL teams already use. Server owns Lightwell + Central members. -->
  <repositories>
    <repository>
      <id>acmebank_java_repo</id>
      <name>Acme Bank Java (existing org virtual)</name>
      <url>${acmebank.repo.url}</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>acmebank_java_repo</id>
      <name>Acme Bank Java (existing org virtual)</name>
      <url>${acmebank.repo.url}</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>

  <dependencies>
    <!-- Client change for Lightwell: ask for a .rhlw version through acmebank. -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.11.0.rhlw-00001</version>
    </dependency>
  </dependencies>
</project>
